<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'kamerton-converter-window-title'}"
                      MinSize="420 380">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
        <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc 'kamerton-converter-window-mode'}" MinWidth="170"/>
            <Label Name="ModeLabel" HorizontalExpand="True"/>
        </BoxContainer>
        <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc 'kamerton-converter-window-status'}" MinWidth="170"/>
            <Label Name="WorkLabel" HorizontalExpand="True"/>
        </BoxContainer>

        <controls:HLine Color="#39C6FF" Thickness="1"/>

        <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc 'kamerton-converter-window-crystals'}" MinWidth="170"/>
            <ProgressBar Name="CrystalBar" HorizontalExpand="True" MinValue="0" MaxValue="1" SetHeight="18"/>
            <Label Name="CrystalLabel" Margin="6 0 0 0" MinWidth="90"/>
        </BoxContainer>
        <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc 'kamerton-converter-window-stable'}" MinWidth="170"/>
            <Label Name="StableLabel" FontColorOverride="#39C6FF" HorizontalExpand="True"/>
        </BoxContainer>
        <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc 'kamerton-converter-window-unstable'}" MinWidth="170"/>
            <Label Name="UnstableLabel" FontColorOverride="#E0304A" HorizontalExpand="True"/>
        </BoxContainer>
        <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc 'kamerton-converter-window-power'}" MinWidth="170"/>
            <ProgressBar Name="PowerBar" HorizontalExpand="True" MinValue="0" MaxValue="1" SetHeight="18"/>
            <Label Name="PowerLabel" Margin="6 0 0 0" MinWidth="90"/>
        </BoxContainer>
        <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc 'kamerton-converter-window-materials'}" MinWidth="170"/>
            <Label Name="MaterialsLabel" HorizontalExpand="True"/>
        </BoxContainer>
        <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc 'kamerton-converter-window-cell'}" MinWidth="170"/>
            <Label Name="CellLabel" HorizontalExpand="True" ClipText="True"/>
        </BoxContainer>
        <Label Name="HintLabel" FontColorOverride="#E0304A"/>

        <BoxContainer Orientation="Horizontal" SeparationOverride="4" VerticalExpand="True" VerticalAlignment="Bottom">
            <Button Name="StartButton" Text="{Loc 'kamerton-converter-window-start'}" HorizontalExpand="True" StyleClasses="OpenRight"/>
            <Button Name="ChargeButton" Text="{Loc 'kamerton-converter-window-charge'}" HorizontalExpand="True" StyleClasses="OpenBoth"/>
            <Button Name="PrintButton" Text="{Loc 'kamerton-converter-window-print'}" HorizontalExpand="True" StyleClasses="OpenBoth"/>
            <Button Name="EjectButton" Text="{Loc 'kamerton-converter-window-eject'}" HorizontalExpand="True" StyleClasses="OpenLeft"/>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
