cmd-gilbertability-desc = Makes Gilbert use one of his rage-phase abilities now (cooldowns ignored).
cmd-gilbertability-help = gilbertability <gilbert uid> leap|cone|levitate|rage [target uid]
cmd-gilbertability-usage = Usage: gilbertability <gilbert uid> leap|cone|levitate [target uid] (leap needs a target).
cmd-gilbertability-not-gilbert = { $uid } is not Gilbert (no rage abilities).
cmd-gilbertability-bad-uid = { $uid } is not an existing entity id.
cmd-gilbertability-not-rage = Gilbert must be in his rage phase (gilbertability <uid> rage first).
cmd-gilbertability-need-target = The leap needs a target.
cmd-gilbertability-failed = Gilbert can't use { $ability } now (busy, in a cutscene or the target is out of reach).
cmd-gilbertability-started = { $gilbert }: { $ability } started.
cmd-gilbertability-hint-gilbert = <gilbert uid>
cmd-gilbertability-hint-ability = <ability>
cmd-gilbertability-hint-target = [target uid]
cmd-gilbertability-rage-failed = He is already past his first phase (or dead).
cmd-gilbertability-rage-started = Second phase started: the transition takes about 7 s, then the abilities can be used.

gilbert-leap-windup = Gilbert crouches, crackling with red sparks!
gilbert-leap-hit = Gilbert pounces on { $target }!
gilbert-levitate-start = Gilbert rises into the air on threads of red lightning!
